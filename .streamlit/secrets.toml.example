# TEMPLATE ONLY. Do not put real values here or commit a real secrets.toml
# (it is gitignored). On Streamlit Community Cloud, paste these keys into
# App -> Settings -> Secrets. See docs/DEPLOY.md.

# Your Anthropic API key. You paste this yourself in the Streamlit dashboard;
# it is never stored in the repo.
ANTHROPIC_API_KEY = "sk-ant-..."

# Cost-safe public demo: bundled samples load pre-computed results from
# demo_cache/ (zero API calls). Set "false" or omit to run everything live.
DEMO_MODE = "true"

# Access code that unlocks live uploads (which do spend the key). Share it only
# with people you want to run their own creatives. Omit it to keep the demo
# cached-only, with no live path at all.
LIVE_PASSWORD = "choose-a-code"

# Optional backstop: max live model runs per browser session.
MAX_LIVE_RUNS = "15"

# Optional model overrides (defaults: Sonnet for judgment, Haiku for fast).
# ANTHROPIC_MODEL = "claude-sonnet-5"
# ANTHROPIC_FAST_MODEL = "claude-haiku-4-5"
