# Copy this file to `.env` and paste your key.  `.env` is gitignored and NEVER committed.
#   copy .env.example .env       (then edit .env)
#
# Get a key at https://console.anthropic.com/  ->  Settings -> API keys -> Create Key
# (add billing credits first under Settings -> Billing).

ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional model override. The default lives in src/model.py. Feature detection and
# claim extraction are simple classification tasks, so a cheaper model is reasonable
# here (your README chooses the model on cost):
# ANTHROPIC_MODEL=claude-haiku-4-5
